{
  "_name": "Fooocus-API: Describe image",
  "_baseUrl": "http://127.0.0.1:8888",
  "kind": "text",
  "_help": "Attach ONE image; the reply is a text description (a prompt you can reuse).",
  "auth": {
    "type": "header",
    "name": "X-API-KEY"
  },
  "models": {
    "path": "/v1/engines/all-models",
    "method": "GET",
    "list": "$.model_filenames[*]"
  },
  "inputs": [
    {
      "id": "type",
      "label": "Image type",
      "type": "select",
      "options": [
        "Photo",
        "Anime"
      ],
      "default": "Photo"
    }
  ],
  "request": {
    "method": "POST",
    "path": "/v1/tools/describe-image",
    "body": {
      "image": {
        "file": "{{image1_base64}}",
        "mime": "{{image1_mime}}",
        "filename": "image.png"
      }
    },
    "query": {
      "type": "{{input.type}}"
    },
    "bodyType": "multipart"
  },
  "response": {
    "type": "json",
    "text": "$.describe"
  },
  "allowEmptyPrompt": true
}
