{
  "_name": "Viggle Image",
  "_baseUrl": "https://apis.viggle.ai/v1",
  "kind": "image",
  "_help": "Viggle Image generation (1-6 PNG images). Base URL: https://apis.viggle.ai/v1 and your Viggle API key. Attached images are used as references.",
  "auth": { "type": "bearer" },
  "inputs": [
    { "id": "aspect", "label": "Aspect ratio", "type": "select", "options": ["1:1", "16:9", "9:16", "4:3", "3:4", "3:2", "2:3"], "default": "1:1" },
    { "id": "resolution", "label": "Resolution", "type": "select", "options": ["1K", "2K"], "default": "1K" },
    { "id": "n", "label": "Number of images", "type": "slider", "min": 1, "max": 6, "step": 1, "default": 1 }
  ],
  "request": {
    "method": "POST",
    "path": "/images",
    "bodyType": "multipart",
    "body": {
      "prompt": "{{prompt}}",
      "aspect_ratio": "{{input.aspect}}",
      "resolution": "{{input.resolution}}",
      "n": "{{input.n}}",
      "reference_image": { "file": "{{image1_base64}}", "mime": "{{image1_mime}}", "filename": "ref1.png" }
    }
  },
  "job": {
    "id": "$.id",
    "poll": {
      "method": "GET",
      "path": "/images/{{job}}",
      "intervalSec": 3,
      "timeoutSec": 900,
      "statusPath": "$.status",
      "done": ["ready"],
      "failed": ["failed"],
      "errorPath": "$.error.message"
    },
    "response": {
      "type": "json",
      "results": [ { "from": "$.images[*].url", "as": "url", "mime": "image/png" } ]
    }
  }
}