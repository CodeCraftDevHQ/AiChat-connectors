{
  "_name": "OpenAI Images",
  "_baseUrl": "https://api.openai.com/v1",
  "kind": "image",
  "_help": "OpenAI image generation. Needs an OpenAI API key.",
  "auth": {
    "type": "bearer"
  },
  "models": {
    "static": [
      "gpt-image-1",
      "dall-e-3"
    ]
  },
  "inputs": [
    {
      "id": "size",
      "label": "Size",
      "type": "select",
      "options": [
        "1024x1024",
        "1536x1024",
        "1024x1536"
      ],
      "default": "1024x1024"
    }
  ],
  "request": {
    "method": "POST",
    "path": "/images/generations",
    "body": {
      "model": "{{model}}",
      "prompt": "{{prompt}}",
      "size": "{{input.size}}",
      "n": 1
    }
  },
  "response": {
    "type": "json",
    "results": [
      {
        "from": "$.data[*].b64_json",
        "as": "base64",
        "mime": "image/png"
      },
      {
        "from": "$.data[*].url",
        "as": "url"
      }
    ]
  }
}
