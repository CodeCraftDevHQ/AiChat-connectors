{
  "_name": "Fooocus-API: Image Prompt / FaceSwap",
  "_baseUrl": "http://127.0.0.1:8888",
  "kind": "image",
  "_help": "Attach 1 or 2 reference images and write a prompt.",
  "auth": {
    "type": "header",
    "name": "X-API-KEY"
  },
  "models": {
    "path": "/v1/engines/all-models",
    "method": "GET",
    "list": "$.model_filenames[*]"
  },
  "inputs": [
    {
      "id": "cn_type",
      "label": "Image use",
      "type": "select",
      "options": [
        "ImagePrompt",
        "FaceSwap",
        "PyraCanny",
        "CPDS"
      ],
      "default": "ImagePrompt"
    },
    {
      "id": "cn_weight",
      "label": "Image weight (0-2)",
      "type": "number",
      "default": "0.6"
    },
    {
      "id": "cn_stop",
      "label": "Stop at (0-1)",
      "type": "number",
      "default": "0.5"
    },
    {
      "id": "aspect",
      "label": "Aspect ratio",
      "type": "select",
      "options": [
        "704*1408",
        "768*1344",
        "832*1216",
        "896*1152",
        "1024*1024",
        "1152*896",
        "1216*832",
        "1344*768",
        "1408*704"
      ],
      "default": "1152*896"
    },
    {
      "id": "performance",
      "label": "Performance",
      "type": "select",
      "options": [
        "Speed",
        "Quality",
        "Extreme Speed"
      ],
      "default": "Speed"
    },
    {
      "id": "negative",
      "label": "Negative prompt",
      "type": "text",
      "default": ""
    },
    {
      "id": "lora",
      "label": "LoRA file name (optional)",
      "type": "text",
      "default": ""
    },
    {
      "id": "lora_weight",
      "label": "LoRA weight (-2 to 2)",
      "type": "number",
      "default": "0.8"
    }
  ],
  "request": {
    "method": "POST",
    "path": "/v2/generation/image-prompt",
    "body": {
      "prompt": "{{prompt}}",
      "negative_prompt": "{{input.negative}}",
      "style_selections": [
        "Fooocus V2",
        "Fooocus Enhance",
        "Fooocus Sharp"
      ],
      "performance_selection": "{{input.performance}}",
      "aspect_ratios_selection": "{{input.aspect}}",
      "image_number": 1,
      "image_seed": -1,
      "sharpness": 2,
      "guidance_scale": 4,
      "base_model_name": "{{model}}",
      "refiner_model_name": "None",
      "refiner_switch": 0.5,
      "save_meta": true,
      "save_extension": "png",
      "require_base64": true,
      "async_process": true,
      "image_prompts": [
        {
          "cn_img": "{{image1_base64}}",
          "cn_type": "{{input.cn_type}}",
          "cn_weight": "{{input.cn_weight}}",
          "cn_stop": "{{input.cn_stop}}"
        },
        {
          "$if": "{{image2_base64}}",
          "cn_img": "{{image2_base64}}",
          "cn_type": "{{input.cn_type}}",
          "cn_weight": "{{input.cn_weight}}",
          "cn_stop": "{{input.cn_stop}}"
        }
      ],
      "loras": [
        {
          "$if": "{{input.lora}}",
          "enabled": true,
          "model_name": "{{input.lora}}",
          "weight": "{{input.lora_weight}}"
        }
      ]
    }
  },
  "job": {
    "id": "$.job_id",
    "cancel": { "method": "POST", "path": "/v1/generation/stop" },
    "poll": {
      "method": "GET",
      "path": "/v1/generation/query-job",
      "query": { "job_id": "{{job}}", "require_step_preview": "false" },
      "intervalSec": 1,
      "timeoutSec": 1800,
      "statusPath": "$.job_stage",
      "done": [ "success" ],
      "failed": [ "error" ],
      "errorPath": "$.job_status",
      "progressPath": "$.job_progress",
      "progressMax": 100
    },
    "response": {
      "results": [ { "from": "$.job_result[*].base64", "as": "base64", "mime": "image/png" } ]
    }
  }
}
