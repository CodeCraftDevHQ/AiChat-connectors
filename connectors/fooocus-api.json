{
  "_name": "Fooocus-API (local)",
  "_baseUrl": "http://127.0.0.1:8888",
  "kind": "image",
  "_help": "Fooocus-API: choose the mode, then fill the options below.",
  "auth": {
    "type": "header",
    "name": "X-API-KEY"
  },
  "models": {
    "path": "/v1/engines/all-models",
    "method": "GET",
    "list": "$.model_filenames[*]"
  },
  "modes": [
    {
      "id": "Text to Image",
      "kind": "image",
      "_help": "Text to image. Optional LoRA.",
      "inputs": [
        {
          "id": "seed",
          "label": "Seed (-1 = random)",
          "type": "number",
          "default": "-1"
        },
        {
          "id": "aspect",
          "label": "Aspect ratio",
          "type": "select",
          "options": [
            "704*1408",
            "768*1344",
            "832*1216",
            "896*1152",
            "1024*1024",
            "1152*896",
            "1216*832",
            "1344*768",
            "1408*704"
          ],
          "default": "1152*896"
        },
        {
          "id": "performance",
          "label": "Performance",
          "type": "select",
          "options": [
            "Speed",
            "Quality",
            "Extreme Speed"
          ],
          "default": "Speed"
        },
        {
          "id": "negative",
          "label": "Negative prompt",
          "type": "text",
          "default": ""
        },
        {
          "id": "lora",
          "label": "LoRA file name (optional)",
          "type": "text",
          "default": ""
        },
        {
          "id": "lora_weight",
          "label": "LoRA weight (-2 to 2)",
          "type": "number",
          "default": "0.8"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/v1/generation/text-to-image",
        "body": {
          "prompt": "{{prompt}}",
          "negative_prompt": "{{input.negative}}",
          "style_selections": [
            "Fooocus V2",
            "Fooocus Enhance",
            "Fooocus Sharp"
          ],
          "performance_selection": "{{input.performance}}",
          "aspect_ratios_selection": "{{input.aspect}}",
          "image_number": 1,
          "image_seed": "{{input.seed}}",
          "sharpness": 2,
          "guidance_scale": 4,
          "base_model_name": "{{model}}",
          "refiner_model_name": "None",
          "refiner_switch": 0.5,
          "save_meta": true,
          "save_extension": "png",
          "require_base64": true,
          "async_process": true,
          "loras": [
            {
              "$if": "{{input.lora}}",
              "enabled": true,
              "model_name": "{{input.lora}}",
              "weight": "{{input.lora_weight}}"
            }
          ]
        }
      },
      "job": {
        "id": "$.job_id",
        "cancel": {
          "method": "POST",
          "path": "/v1/generation/stop"
        },
        "poll": {
          "method": "GET",
          "path": "/v1/generation/query-job",
          "query": {
            "job_id": "{{job}}",
            "require_step_preview": "false"
          },
          "intervalSec": 1,
          "timeoutSec": 1800,
          "statusPath": "$.job_stage",
          "done": [
            "success"
          ],
          "failed": [
            "error"
          ],
          "errorPath": "$.job_status",
          "progressPath": "$.job_progress",
          "progressMax": 100
        },
        "response": {
          "seeds": "$.job_result[*].seed",
          "results": [
            {
              "from": "$.job_result[*].base64",
              "as": "base64",
              "mime": "image/png"
            }
          ]
        }
      }
    },
    {
      "id": "Image Prompt / Face Swap",
      "kind": "image",
      "_help": "Attach 1 or 2 reference images and write a prompt.",
      "inputs": [
        {
          "id": "seed",
          "label": "Seed (-1 = random)",
          "type": "number",
          "default": "-1"
        },
        {
          "id": "cn_type",
          "label": "Image use",
          "type": "select",
          "options": [
            "ImagePrompt",
            "FaceSwap",
            "PyraCanny",
            "CPDS"
          ],
          "default": "ImagePrompt"
        },
        {
          "id": "cn_weight",
          "label": "Image weight (0-2)",
          "type": "number",
          "default": "0.6"
        },
        {
          "id": "cn_stop",
          "label": "Stop at (0-1)",
          "type": "number",
          "default": "0.5"
        },
        {
          "id": "aspect",
          "label": "Aspect ratio",
          "type": "select",
          "options": [
            "704*1408",
            "768*1344",
            "832*1216",
            "896*1152",
            "1024*1024",
            "1152*896",
            "1216*832",
            "1344*768",
            "1408*704"
          ],
          "default": "1152*896"
        },
        {
          "id": "performance",
          "label": "Performance",
          "type": "select",
          "options": [
            "Speed",
            "Quality",
            "Extreme Speed"
          ],
          "default": "Speed"
        },
        {
          "id": "negative",
          "label": "Negative prompt",
          "type": "text",
          "default": ""
        },
        {
          "id": "lora",
          "label": "LoRA file name (optional)",
          "type": "text",
          "default": ""
        },
        {
          "id": "lora_weight",
          "label": "LoRA weight (-2 to 2)",
          "type": "number",
          "default": "0.8"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/v2/generation/image-prompt",
        "body": {
          "prompt": "{{prompt}}",
          "negative_prompt": "{{input.negative}}",
          "style_selections": [
            "Fooocus V2",
            "Fooocus Enhance",
            "Fooocus Sharp"
          ],
          "performance_selection": "{{input.performance}}",
          "aspect_ratios_selection": "{{input.aspect}}",
          "image_number": 1,
          "image_seed": "{{input.seed}}",
          "sharpness": 2,
          "guidance_scale": 4,
          "base_model_name": "{{model}}",
          "refiner_model_name": "None",
          "refiner_switch": 0.5,
          "save_meta": true,
          "save_extension": "png",
          "require_base64": true,
          "async_process": true,
          "image_prompts": [
            {
              "cn_img": "{{image1_base64}}",
              "cn_type": "{{input.cn_type}}",
              "cn_weight": "{{input.cn_weight}}",
              "cn_stop": "{{input.cn_stop}}"
            },
            {
              "$if": "{{image2_base64}}",
              "cn_img": "{{image2_base64}}",
              "cn_type": "{{input.cn_type}}",
              "cn_weight": "{{input.cn_weight}}",
              "cn_stop": "{{input.cn_stop}}"
            }
          ],
          "loras": [
            {
              "$if": "{{input.lora}}",
              "enabled": true,
              "model_name": "{{input.lora}}",
              "weight": "{{input.lora_weight}}"
            }
          ]
        }
      },
      "job": {
        "id": "$.job_id",
        "cancel": {
          "method": "POST",
          "path": "/v1/generation/stop"
        },
        "poll": {
          "method": "GET",
          "path": "/v1/generation/query-job",
          "query": {
            "job_id": "{{job}}",
            "require_step_preview": "false"
          },
          "intervalSec": 1,
          "timeoutSec": 1800,
          "statusPath": "$.job_stage",
          "done": [
            "success"
          ],
          "failed": [
            "error"
          ],
          "errorPath": "$.job_status",
          "progressPath": "$.job_progress",
          "progressMax": 100
        },
        "response": {
          "seeds": "$.job_result[*].seed",
          "results": [
            {
              "from": "$.job_result[*].base64",
              "as": "base64",
              "mime": "image/png"
            }
          ]
        }
      }
    },
    {
      "id": "Upscale / Vary",
      "kind": "image",
      "_help": "Attach ONE image. Vary: the message can describe the image (optional).",
      "allowEmptyPrompt": true,
      "inputs": [
        {
          "id": "seed",
          "label": "Seed (-1 = random)",
          "type": "number",
          "default": "-1"
        },
        {
          "id": "method",
          "label": "Method",
          "type": "select",
          "options": [
            "Upscale (2x)",
            "Upscale (1.5x)",
            "Upscale (Fast 2x)",
            "Upscale (Custom)",
            "Vary (Subtle)",
            "Vary (Strong)"
          ],
          "default": "Upscale (2x)"
        },
        {
          "id": "custom_scale",
          "label": "Custom upscale factor (1.0-5.0)",
          "type": "number",
          "default": ""
        },
        {
          "id": "performance",
          "label": "Performance",
          "type": "select",
          "options": [
            "Speed",
            "Quality",
            "Extreme Speed"
          ],
          "default": "Speed"
        },
        {
          "id": "negative",
          "label": "Negative prompt",
          "type": "text",
          "default": ""
        }
      ],
      "request": {
        "method": "POST",
        "path": "/v2/generation/image-upscale-vary",
        "body": {
          "prompt": "{{prompt}}",
          "negative_prompt": "{{input.negative}}",
          "style_selections": [],
          "performance_selection": "{{input.performance}}",
          "image_number": 1,
          "image_seed": "{{input.seed}}",
          "sharpness": 2,
          "guidance_scale": 4,
          "base_model_name": "{{model}}",
          "refiner_model_name": "None",
          "refiner_switch": 0.5,
          "save_meta": true,
          "save_extension": "png",
          "require_base64": true,
          "async_process": true,
          "input_image": "{{image1_base64}}",
          "uov_method": "{{input.method}}",
          "upscale_value": "{{input.custom_scale}}"
        }
      },
      "job": {
        "id": "$.job_id",
        "cancel": {
          "method": "POST",
          "path": "/v1/generation/stop"
        },
        "poll": {
          "method": "GET",
          "path": "/v1/generation/query-job",
          "query": {
            "job_id": "{{job}}",
            "require_step_preview": "false"
          },
          "intervalSec": 1,
          "timeoutSec": 1800,
          "statusPath": "$.job_stage",
          "done": [
            "success"
          ],
          "failed": [
            "error"
          ],
          "errorPath": "$.job_status",
          "progressPath": "$.job_progress",
          "progressMax": 100
        },
        "response": {
          "seeds": "$.job_result[*].seed",
          "results": [
            {
              "from": "$.job_result[*].base64",
              "as": "base64",
              "mime": "image/png"
            }
          ]
        }
      }
    },
    {
      "id": "Inpaint",
      "kind": "image",
      "_help": "Attach TWO images: first the original, second the mask (same size; WHITE = area to change, BLACK = keep). The message describes what should appear.",
      "inputs": [
        {
          "id": "seed",
          "label": "Seed (-1 = random)",
          "type": "number",
          "default": "-1"
        },
        {
          "id": "performance",
          "label": "Performance",
          "type": "select",
          "options": [
            "Speed",
            "Quality",
            "Extreme Speed"
          ],
          "default": "Speed"
        },
        {
          "id": "negative",
          "label": "Negative prompt",
          "type": "text",
          "default": ""
        },
        {
          "id": "aspect",
          "label": "Aspect ratio",
          "type": "select",
          "options": [
            "704*1408",
            "768*1344",
            "832*1216",
            "896*1152",
            "1024*1024",
            "1152*896",
            "1216*832",
            "1344*768",
            "1408*704"
          ],
          "default": "1152*896"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/v2/generation/image-inpaint-outpaint",
        "body": {
          "prompt": "",
          "negative_prompt": "{{input.negative}}",
          "style_selections": [
            "Fooocus V2",
            "Fooocus Enhance",
            "Fooocus Sharp"
          ],
          "performance_selection": "{{input.performance}}",
          "aspect_ratios_selection": "{{input.aspect}}",
          "image_number": 1,
          "image_seed": "{{input.seed}}",
          "sharpness": 2,
          "guidance_scale": 4,
          "base_model_name": "{{model}}",
          "refiner_model_name": "None",
          "refiner_switch": 0.5,
          "save_meta": true,
          "save_extension": "png",
          "require_base64": true,
          "async_process": true,
          "input_image": "{{image1_base64}}",
          "input_mask": "{{image2_base64}}",
          "inpaint_additional_prompt": "{{prompt}}"
        }
      },
      "job": {
        "id": "$.job_id",
        "cancel": {
          "method": "POST",
          "path": "/v1/generation/stop"
        },
        "poll": {
          "method": "GET",
          "path": "/v1/generation/query-job",
          "query": {
            "job_id": "{{job}}",
            "require_step_preview": "false"
          },
          "intervalSec": 1,
          "timeoutSec": 1800,
          "statusPath": "$.job_stage",
          "done": [
            "success"
          ],
          "failed": [
            "error"
          ],
          "errorPath": "$.job_status",
          "progressPath": "$.job_progress",
          "progressMax": 100
        },
        "response": {
          "seeds": "$.job_result[*].seed",
          "results": [
            {
              "from": "$.job_result[*].base64",
              "as": "base64",
              "mime": "image/png"
            }
          ]
        }
      }
    },
    {
      "id": "Outpaint",
      "kind": "image",
      "_help": "Attach ONE image. The message (optional) describes the new area.",
      "allowEmptyPrompt": true,
      "inputs": [
        {
          "id": "seed",
          "label": "Seed (-1 = random)",
          "type": "number",
          "default": "-1"
        },
        {
          "id": "direction",
          "label": "Direction",
          "type": "select",
          "options": [
            "Left",
            "Right",
            "Top",
            "Bottom"
          ],
          "default": "Left"
        },
        {
          "id": "performance",
          "label": "Performance",
          "type": "select",
          "options": [
            "Speed",
            "Quality",
            "Extreme Speed"
          ],
          "default": "Speed"
        },
        {
          "id": "negative",
          "label": "Negative prompt",
          "type": "text",
          "default": ""
        },
        {
          "id": "aspect",
          "label": "Aspect ratio",
          "type": "select",
          "options": [
            "704*1408",
            "768*1344",
            "832*1216",
            "896*1152",
            "1024*1024",
            "1152*896",
            "1216*832",
            "1344*768",
            "1408*704"
          ],
          "default": "1152*896"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/v2/generation/image-inpaint-outpaint",
        "body": {
          "prompt": "",
          "negative_prompt": "{{input.negative}}",
          "style_selections": [
            "Fooocus V2",
            "Fooocus Enhance",
            "Fooocus Sharp"
          ],
          "performance_selection": "{{input.performance}}",
          "aspect_ratios_selection": "{{input.aspect}}",
          "image_number": 1,
          "image_seed": "{{input.seed}}",
          "sharpness": 2,
          "guidance_scale": 4,
          "base_model_name": "{{model}}",
          "refiner_model_name": "None",
          "refiner_switch": 0.5,
          "save_meta": true,
          "save_extension": "png",
          "require_base64": true,
          "async_process": true,
          "input_image": "{{image1_base64}}",
          "outpaint_selections": [
            "{{input.direction}}"
          ],
          "outpaint_distance_left": -1,
          "outpaint_distance_right": -1,
          "outpaint_distance_top": -1,
          "outpaint_distance_bottom": -1,
          "inpaint_additional_prompt": "{{prompt}}"
        }
      },
      "job": {
        "id": "$.job_id",
        "cancel": {
          "method": "POST",
          "path": "/v1/generation/stop"
        },
        "poll": {
          "method": "GET",
          "path": "/v1/generation/query-job",
          "query": {
            "job_id": "{{job}}",
            "require_step_preview": "false"
          },
          "intervalSec": 1,
          "timeoutSec": 1800,
          "statusPath": "$.job_stage",
          "done": [
            "success"
          ],
          "failed": [
            "error"
          ],
          "errorPath": "$.job_status",
          "progressPath": "$.job_progress",
          "progressMax": 100
        },
        "response": {
          "seeds": "$.job_result[*].seed",
          "results": [
            {
              "from": "$.job_result[*].base64",
              "as": "base64",
              "mime": "image/png"
            }
          ]
        }
      }
    },
    {
      "id": "Describe image",
      "kind": "text",
      "_help": "Attach ONE image; the reply is a text description (a prompt you can reuse).",
      "allowEmptyPrompt": true,
      "inputs": [
        {
          "id": "type",
          "label": "Image type",
          "type": "select",
          "options": [
            "Photo",
            "Anime"
          ],
          "default": "Photo"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/v1/tools/describe-image",
        "body": {
          "image": {
            "file": "{{image1_base64}}",
            "mime": "{{image1_mime}}",
            "filename": "image.png"
          }
        },
        "query": {
          "type": "{{input.type}}"
        },
        "bodyType": "multipart"
      },
      "response": {
        "type": "json",
        "text": "$.describe"
      }
    }
  ]
}
